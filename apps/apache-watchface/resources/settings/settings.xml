<?xml version="1.0" encoding="UTF-8"?>
<settings>
    <setting propertyKey="@Properties.dateFormatDDMM" title="@Strings.SettingDateFormatTitle">
        <settingConfig type="list">
            <listEntry value="1">@Strings.SettingDateFormatDDMM</listEntry>
            <listEntry value="0">@Strings.SettingDateFormatMMDD</listEntry>
        </settingConfig>
    </setting>

    <!-- V6: Timezone 2 picker - see source/TzCalc.mc for why this can't
         just read a device setting. Values must match TzCalc.ZONE_*. -->
    <setting propertyKey="@Properties.timezone2" title="@Strings.SettingTimezone2Title">
        <settingConfig type="list">
            <listEntry value="0">@Strings.SettingTz2Pacific</listEntry>
            <listEntry value="1">@Strings.SettingTz2Mountain</listEntry>
            <listEntry value="2">@Strings.SettingTz2Central</listEntry>
            <listEntry value="3">@Strings.SettingTz2Eastern</listEntry>
            <listEntry value="4">@Strings.SettingTz2Alaska</listEntry>
            <listEntry value="5">@Strings.SettingTz2Hawaii</listEntry>
            <listEntry value="6">@Strings.SettingTz2Utc</listEntry>
        </settingConfig>
    </setting>

    <!-- V6: free-text fields, edited via the Garmin Connect Mobile
         companion app. maxLength values are bezel-margin-driven (see
         TITLE_MAX_HALF_W / FOOTER_MAX_HALF_W in ApacheWatchFaceView.mc,
         both near-pole rows with limited safe half-width), not arbitrary. -->
    <setting propertyKey="@Properties.airframe" title="@Strings.SettingAirframeTitle">
        <settingConfig type="alphaNumeric" maxLength="10"/>
    </setting>
    <setting propertyKey="@Properties.squad" title="@Strings.SettingSquadTitle">
        <settingConfig type="alphaNumeric" maxLength="8"/>
    </setting>
</settings>
